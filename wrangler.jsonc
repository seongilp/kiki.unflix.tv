{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiki",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "routes": [
    // Custom domain. Resolves once unflix.tv's nameservers point to Cloudflare.
    { "pattern": "kiki.unflix.tv", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    // Risk intelligence time series (snapshots + alerts).
    {
      // 운영 배포는 ebs standalone 이라 실제로는 D1_SHIM_PATH
      // (kiki-risk.sqlite)가 쓰인다. 아래는 Workers 경로용 실제 DB.
      "binding": "RISK_DB",
      "database_name": "kiki-risk",
      "database_id": "094cc78d-4558-47d0-9092-e5131a2dff75"
    }
  ],
  "kv_namespaces": [
    // App cache: video / Shorts classification per channel.
    // 키키 전용 네임스페이스(kiki- 접두사) — 다른 워커의 `feed:v1` 과
    // 절대 섞이지 않는다. ebs standalone 에서는 KV_SHIM_DIR 이 대신 쓰인다.
    {
      "binding": "SHORTS_CACHE",
      "id": "46b78193c37d43759892fe4d880e58aa"
    },
    // OpenNext incremental cache (ISR / Next data cache).
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "555c02d5958947698a9ac6803d1be242"
    }
  ]
}
